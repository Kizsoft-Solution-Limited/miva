# Copy to .env and fill in. Never commit .env.

DATABASE_URL="file:./dev.db"
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional override; default openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o
PORT=3000
# Comma-separated for multiple frontends, e.g. local + production
CORS_ORIGIN=http://localhost:5173

# Auth token signing. Change in production.
AUTH_SECRET=miva-demo-auth-secret
# Cross-site cookie (Vercel → Render): leave unset in production (SameSite=None).
# Local Vite proxy / same-site: COOKIE_SAMESITE=lax
# COOKIE_SAMESITE=lax

# Optional: raises GitHub API rate limits on Render
# GITHUB_TOKEN=
